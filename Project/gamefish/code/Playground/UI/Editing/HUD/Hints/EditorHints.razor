@using Sandbox;
@using Sandbox.UI;
@using GameFish;
@using GameFish.Razor;

@inherits Panel

@namespace Fishbox.Razor

<root>

	<Keybind Action="@EditorMenuAction" Text="Menu" tooltip="Press to toggle, hold to auto-close." />
	<Keybind Action="@EditorCursorAction" Text="Cursor" tooltip="Press to toggle the cursor." />

	<Keybind Action="Noclip" Text="@(IsSpectator ? "Play" : "Noclip")" />

	@if (!IsSpectator)
	{
		<Keybind Action="Hook" Text="Hook" />
		<Keybind Action="Item" Text="Gravity" />
	}

</root>
